generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ONLINE
  GETTING_BORED
  IN_CHAT
  DEACTIVATED
}

enum PaperPlaneStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

enum ReportTargetType {
  PULSE
  NOTE
  MESSAGE
  USER
  STICKY_NOTE
  STICKY_COMMENT
  COFFEE_MESSAGE
}

enum CoffeeBreakRoomStatus {
  WAITING
  ACTIVE
  ENDED
  CANCELLED
}

enum TicTacToeGameStatus {
  WAITING
  ACTIVE
  FINISHED
  CANCELLED
}

enum ReportStatus {
  OPEN
  REVIEWED
  DISMISSED
  ACTIONED
}

enum ProfilePhotoVisibility {
  PRIVATE
  PUBLIC
}

enum AppNotificationType {
  STICKY_NOTE_COMMENT
  STICKY_NOTE_REPLY
  PAPER_PLANE
  CHARTER_PLANE
  DIRECT_MESSAGE
  CONVERSATION_ENDED
  MODERATION_ACTION
  CONNECTION_UPDATE
}

enum FriendshipLevel {
  STRANGER
  ACQUAINTANCE
  FRIEND
  CLOSE_FRIEND
}

enum ConversationPromptStatus {
  OFFERED
  ACTIVE
  COMPLETED
  DECLINED
}

model User {
  id                String     @id @default(cuid())
  anonymousUsername String     @unique
  googleId          String?    @unique
  email             String?    @unique
  publicAvatarUrl   String?    @db.VarChar(1000)
  publicFlair       String?    @db.VarChar(40)
  bio               String?    @db.VarChar(160)
  dateOfBirth       DateTime?
  gender            String?    @db.VarChar(40)
  socialLink        String?    @db.VarChar(500)
  deletedAt         DateTime?
  termsAcceptedAt   DateTime?
  status            UserStatus @default(ONLINE)
  lastActiveAt      DateTime   @default(now())
  createdAt         DateTime   @default(now())

  createdChats Chat[] @relation("ChatUser1")
  joinedChats  Chat[] @relation("ChatUser2")
  messages     Message[]
  reports      ContentReport[] @relation("Reporter")
  blocksCreated UserBlock[] @relation("Blocker")
  blocksReceived UserBlock[] @relation("Blocked")
  sentPaperPlanes PaperPlaneInvite[] @relation("PaperPlaneSender")
  receivedPaperPlanes PaperPlaneInvite[] @relation("PaperPlaneRecipient")
  coffeeQueue CoffeeQueue?
  coffeeBreakParticipants CoffeeBreakParticipant[]
  coffeeBreakMessages CoffeeBreakMessage[]
  deskStickyNotes DeskStickyNote[]
  stickyApplauds StickyNoteApplaud[]
  stickyComments StickyNoteComment[]
  profilePhotos ProfilePhoto[] @relation("ProfilePhotoOwner")
  receivedProfilePhotoShares ProfilePhotoShare[] @relation("ProfilePhotoRecipient")
  paisaWallet PaisaWallet?
  notifications AppNotification[]
  pushDevices PushDevice[]
  ticTacToeGamesAsX TicTacToeGame[] @relation("TicTacToePlayerX")
  ticTacToeGamesAsO TicTacToeGame[] @relation("TicTacToePlayerO")
  ticTacToeWins TicTacToeGame[] @relation("TicTacToeWinner")
}

// A small, anonymous open match. It is intentionally not connected to a
// private chat or Work Circle, so it cannot expose a public member directory.
model TicTacToeGame {
  id           String               @id @default(cuid())
  playerXId    String
  playerOId    String?
  board        String               @db.VarChar(9) @default(".........")
  turnUserId   String?
  winnerUserId String?
  status       TicTacToeGameStatus  @default(WAITING)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  finishedAt   DateTime?

  playerX User  @relation("TicTacToePlayerX", fields: [playerXId], references: [id], onDelete: Cascade)
  playerO User? @relation("TicTacToePlayerO", fields: [playerOId], references: [id], onDelete: SetNull)
  winner  User? @relation("TicTacToeWinner", fields: [winnerUserId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([playerXId, status])
  @@index([playerOId, status])
}

model CoffeeQueue {
  userId String @id
  topic String @db.VarChar(60)
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([topic, createdAt])
}

// A Coffee Break Room is deliberately short-lived.  Messages are removed as
// soon as the room ends, while the participant list stays available briefly
// so members can choose whether to send a Charter Plane afterwards.
model CoffeeBreakRoom {
  id          String                @id @default(cuid())
  status      CoffeeBreakRoomStatus @default(WAITING)
  prompt      String                @db.VarChar(240)
  createdAt   DateTime              @default(now())
  startedAt   DateTime?
  endsAt      DateTime?
  endedAt     DateTime?

  participants CoffeeBreakParticipant[]
  messages     CoffeeBreakMessage[]

  @@index([status, createdAt])
  @@index([status, endsAt])
}

model CoffeeBreakParticipant {
  roomId   String
  userId   String
  joinedAt DateTime @default(now())
  leftAt   DateTime?

  room CoffeeBreakRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([roomId, userId])
  @@index([userId, leftAt])
}

model CoffeeBreakMessage {
  id        String   @id @default(cuid())
  roomId    String
  senderId  String
  text      String   @db.VarChar(500)
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())

  room   CoffeeBreakRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender User            @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
}

model PaperPlaneInvite {
  id          String           @id @default(cuid())
  senderId    String
  recipientId String
  message     String           @db.VarChar(160)
  isCharter   Boolean          @default(false)
  status      PaperPlaneStatus @default(PENDING)
  expiresAt   DateTime
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  sender    User @relation("PaperPlaneSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("PaperPlaneRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, status, expiresAt])
  @@index([senderId, status])
}

model UserBlock {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

model ContentReport {
  id           String @id @default(cuid())
  reporterId   String
  targetType   ReportTargetType
  targetId     String
  reason       String @db.VarChar(500)
  details      String? @db.VarChar(1000)
  status       ReportStatus @default(OPEN)
  createdAt    DateTime @default(now())
  reviewedAt   DateTime?

  reporter User @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([targetType, targetId])
}

// Moderation is deliberately reversible. Content remains in the database for
// audit purposes, while normal app queries omit anything with a live action.
model ModerationAction {
  id         String           @id @default(cuid())
  reportId   String           @unique
  targetType ReportTargetType
  targetId   String
  authorId   String
  reason     String           @db.VarChar(500)
  createdAt  DateTime         @default(now())

  @@unique([targetType, targetId])
  @@index([targetType, targetId])
  @@index([authorId, createdAt])
}

model Chat {
  id        String   @id @default(cuid())
  user1Id   String
  user2Id   String
  createdAt DateTime @default(now())
  endedAt   DateTime?
  isDirect  Boolean  @default(false)
  lastMessageAt DateTime?
  profileSharedByUser1 Boolean @default(false)
  profileSharedByUser2 Boolean @default(false)
  friendshipLevel FriendshipLevel @default(STRANGER)
  levelRequest FriendshipLevel?
  levelRequestedById String?

  user1 User @relation("ChatUser1", fields: [user1Id], references: [id])
  user2 User @relation("ChatUser2", fields: [user2Id], references: [id])
  messages Message[]
  prompts ConversationPrompt[]

  @@index([friendshipLevel])
}

// Prompts are private to one direct conversation. An answer remains hidden
// until both members have chosen to answer it.
model ConversationPrompt {
  id String @id @default(cuid())
  chatId String
  question String @db.VarChar(320)
  targetLevel FriendshipLevel
  status ConversationPromptStatus @default(OFFERED)
  proposerId String
  user1Accepted Boolean @default(false)
  user2Accepted Boolean @default(false)
  user1Answer String? @db.VarChar(600)
  user2Answer String? @db.VarChar(600)
  createdAt DateTime @default(now())
  completedAt DateTime?

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, status, createdAt])
}

model Message {
  id        String   @id @default(cuid())
  chatId    String
  senderId  String
  text      String
  createdAt DateTime @default(now())
  readAt DateTime?

  chat   Chat @relation(fields: [chatId], references: [id])
  sender User @relation(fields: [senderId], references: [id])
}

model DeskStickyNote {
  id        String   @id @default(cuid())
  authorId  String
  text      String   @db.VarChar(160)
  createdAt DateTime @default(now())
  deletedAt DateTime?

  author    User                @relation(fields: [authorId], references: [id], onDelete: Cascade)
  applauds  StickyNoteApplaud[]
  comments  StickyNoteComment[]

  @@index([createdAt])
  @@index([authorId, createdAt])
  @@index([deletedAt])
}

model StickyNoteApplaud {
  userId     String
  stickyNoteId String
  createdAt  DateTime @default(now())

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  stickyNote DeskStickyNote  @relation(fields: [stickyNoteId], references: [id], onDelete: Cascade)

  @@id([userId, stickyNoteId])
  @@index([stickyNoteId])
}

model StickyNoteComment {
  id           String   @id @default(cuid())
  stickyNoteId String
  authorId     String
  text         String   @db.VarChar(300)
  authorReply  String?  @db.VarChar(240)
  authorRepliedAt DateTime?
  createdAt    DateTime @default(now())

  stickyNote   DeskStickyNote @relation(fields: [stickyNoteId], references: [id], onDelete: Cascade)
  author       User           @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([stickyNoteId, createdAt])
}

model AppNotification {
  id        String              @id @default(cuid())
  userId    String
  type      AppNotificationType
  title     String              @db.VarChar(120)
  detail    String              @db.VarChar(400)
  link      String?             @db.VarChar(500)
  readAt    DateTime?
  createdAt DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model PushDevice {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique @db.VarChar(255)
  platform  String   @db.VarChar(16)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

model ProfilePhoto {
  id         String                 @id @default(cuid())
  ownerId    String
  url        String                 @db.VarChar(1000)
  visibility ProfilePhotoVisibility @default(PRIVATE)
  createdAt  DateTime               @default(now())

  owner      User                @relation("ProfilePhotoOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  shares     ProfilePhotoShare[]

  @@index([ownerId, createdAt])
  @@index([ownerId, visibility])
}

model ProfilePhotoShare {
  photoId     String
  recipientId String
  createdAt   DateTime @default(now())

  photo       ProfilePhoto @relation(fields: [photoId], references: [id], onDelete: Cascade)
  recipient   User         @relation("ProfilePhotoRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@id([photoId, recipientId])
  @@index([recipientId])
}

// Paisa is a virtual Breakroom balance. It has no cash value and cannot be
// withdrawn or transferred outside the app.
model PaisaWallet {
  userId    String   @id
  balance   Int      @default(50000)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
